{
  "name": "no_logic_game_server",
  "version": "1.0.0",
  "private": true,
  "description": "Simple server for games with logic on client",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test test/*.test.cjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "demo": "node scripts/demo.mjs",
    "benchmark": "npm run build && node scripts/benchmark.cjs"
  },
  "author": "Alexander Arkharov",
  "license": "MIT",
  "dependencies": { "ws": "^8.22.0" },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
